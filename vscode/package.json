{
  "name": "agt-vscode",
  "displayName": "AGT — Multi-Agent Bridge",
  "description": "VS Code client for the local agt server: daemons, agent runtimes, chat, SOP and goal orchestration.",
  "version": "0.1.0",
  "publisher": "half-island-box",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/half-island-box/agent-team.git"
  },
  "private": true,
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agt-daemons",
          "title": "AGT Daemons",
          "icon": "media/agt.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "agt-sidebar",
          "title": "AGT",
          "icon": "media/agt.svg"
        }
      ]
    },
    "views": {
      "agt-daemons": [
        {
          "id": "agt.daemons",
          "name": "Daemons"
        },
        {
          "id": "agt.usage",
          "name": "Usage",
          "type": "webview"
        }
      ],
      "agt-sidebar": [
        {
          "id": "agt.workspace",
          "name": "AGT",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "agt.showChat",
        "title": "AGT: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agt.showSop",
        "title": "AGT: Open SOP Editor",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "agt.showGoal",
        "title": "AGT: Open Goal",
        "icon": "$(rocket)"
      },
      {
        "command": "agt.newSop",
        "title": "AGT: New SOP Template",
        "icon": "$(new-file)"
      },
      {
        "command": "agt.openSopEditor",
        "title": "AGT: Open With SOP Editor"
      },
      {
        "command": "agt.showSettings",
        "title": "AGT: Open Settings",
        "icon": "$(settings-gear)"
      },
      {
        "command": "agt.refresh",
        "title": "AGT: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "agt.startServer",
        "title": "AGT: Start Server"
      },
      {
        "command": "agt.stopServer",
        "title": "AGT: Stop Server"
      },
      {
        "command": "agt.startDaemon",
        "title": "AGT: Start Local Daemon"
      },
      {
        "command": "agt.stopDaemon",
        "title": "AGT: Stop Local Daemon"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agt.showChat",
          "when": "view == agt.daemons",
          "group": "navigation"
        },
        {
          "command": "agt.showSop",
          "when": "view == agt.daemons",
          "group": "navigation"
        },
        {
          "command": "agt.showGoal",
          "when": "view == agt.daemons",
          "group": "navigation"
        },
        {
          "command": "agt.newSop",
          "when": "view == agt.daemons",
          "group": "navigation"
        },
        {
          "command": "agt.showSettings",
          "when": "view == agt.daemons",
          "group": "navigation"
        },
        {
          "command": "agt.refresh",
          "when": "view == agt.daemons",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "agt.openSopEditor",
          "when": "resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "AGT",
      "properties": {
        "agt.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8420",
          "description": "Base URL of the agt server"
        },
        "agt.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the agt server automatically when it is unreachable"
        },
        "agt.startCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command used to start the agt server. Leave empty to use the detected agt backend."
        },
        "agt.stopCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command used to stop the agt server. Leave empty to use the detected agt backend."
        },
        "agt.autoStartDaemon": {
          "type": "boolean",
          "default": true,
          "description": "Also start the local daemon when the server is started by the extension"
        },
        "agt.daemonStartCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command used to start the local daemon (AGT_SERVER_URL is exported for it). Leave empty to use the detected agt backend."
        },
        "agt.daemonStopCommand": {
          "type": "string",
          "default": "",
          "description": "Shell command used to stop the local daemon. Leave empty to use the detected agt backend."
        },
        "agt.agtPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the agt executable. Leave empty to detect the private environment, then PATH, then an agt-team workspace."
        },
        "agt.autoInstallBackend": {
          "type": "string",
          "enum": [
            "prompt",
            "off"
          ],
          "default": "prompt",
          "description": "Ask before installing the agt backend when none is detected. Installing always requires confirming a dialog; \"off\" only shows the status-bar entry."
        },
        "agt.language": {
          "type": "string",
          "enum": [
            "zh",
            "en"
          ],
          "default": "zh",
          "description": "UI language for AGT views (static text only)"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "build:console": "node esbuild.js --production --console",
    "build:all": "npm run build && npm run build:console",
    "watch": "node esbuild.js --watch",
    "test:core": "esbuild tests/sop-core.test.ts --bundle --platform=node --format=cjs --outfile=dist/test/sop-core.test.cjs --log-level=warning && node --test dist/test/sop-core.test.cjs",
    "test:inspector": "esbuild tests/sop-inspector.test.ts --bundle --platform=node --format=cjs --outfile=dist/test/sop-inspector.test.cjs --log-level=warning && node --test dist/test/sop-inspector.test.cjs",
    "test:run": "esbuild tests/sop-run.test.ts --bundle --platform=node --format=cjs --outfile=dist/test/sop-run.test.cjs --log-level=warning && node --test dist/test/sop-run.test.cjs",
    "test:loop": "esbuild tests/sop-loop.test.ts --bundle --platform=node --format=cjs --outfile=dist/test/sop-loop.test.cjs --log-level=warning && node --test dist/test/sop-loop.test.cjs",
    "test:backend": "esbuild tests/backend.test.ts --bundle --platform=node --format=cjs --outfile=dist/test/backend.test.cjs --log-level=warning && node --test dist/test/backend.test.cjs",
    "check:sop": "esbuild tests/roundtrip-check.ts --bundle --platform=node --format=cjs --outfile=dist/test/roundtrip-check.cjs --log-level=warning && node dist/test/roundtrip-check.cjs && cd .. && uv run agt sop validate /tmp/agt-sop-roundtrip/edited.sop.yaml",
    "check:server-endpoint": "esbuild tests/probe-validate-endpoint.ts --bundle --platform=node --format=cjs --outfile=dist/test/probe-validate-endpoint.cjs --log-level=warning && node dist/test/probe-validate-endpoint.cjs",
    "check:run": "esbuild tests/probe-sop-run.ts --bundle --platform=node --format=cjs --outfile=dist/test/probe-sop-run.cjs --log-level=warning && node dist/test/probe-sop-run.cjs",
    "typecheck": "tsc --noEmit",
    "dev:web": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.104.0",
    "esbuild": "0.28.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@lobehub/icons-static-svg": "^1.95.1",
    "dompurify": "3.4.17",
    "marked": "^18.0.14",
    "yaml": "^2.9.1"
  }
}
